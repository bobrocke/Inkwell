{
  "name": "inkwell-ssg",
  "version": "0.3.0",
  "description": "An opinionated, batteries-included, static site generator written in TypeScript",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "inkwell": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "SSG",
    "Batteries-Included",
    "TypeScript"
  ],
  "author": "Bob Rockefeller",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bobrockefeller/inkwell-ssg.git"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@silvenon/remark-smartypants": "^1.0.0",
    "chokidar": "^4.0.0",
    "citty": "^0.1.6",
    "consola": "^3.2.3",
    "exifr": "^7.1.3",
    "fast-glob": "^3.3.2",
    "jiti": "^2.4.2",
    "lightningcss": "^1.28.2",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.0",
    "remark": "^15.0.1",
    "remark-definition-list": "^2.0.0",
    "remark-directive": "^4.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.1",
    "shiki": "^1.29.2",
    "sirv": "^3.0.0",
    "ventojs": "^1.12.11",
    "yaml": "^2.8.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.1.2"
  }
}
